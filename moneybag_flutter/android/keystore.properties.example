# Release signing for MoneyBag (মানিব্যাগ) — copy to android/keystore.properties
# and fill in your values. NEVER commit the real file.
#
# Create the key once (any machine, keep the .jks safe forever):
#   keytool -genkey -v -keystore ~/moneybag-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias moneybag
#
# storeFile is resolved relative to android/app/ — use ../../ for the
# home directory in this example; adjust to wherever the jks lives.
storeFile=../../moneybag-release.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=moneybag
keyPassword=YOUR_KEY_PASSWORD

<?xml version="1.0" encoding="utf-8"?>
<!-- v2.2.3 — MoneyBag home screen widget.
     Brand header, today's spend (big) + this month's spend (small).
     All text is supplied at runtime from the Dart side (localized + ৳ formatted).

     ⚠ RemoteViews WHITELIST (the v2.1–v2.2.2 "blank white widget" bug):
     launchers inflate widget layouts through RemoteViews, which only allows
     FrameLayout/LinearLayout/RelativeLayout/GridLayout + TextView/ImageView/
     ProgressBar/Button/etc. `android.widget.Space` is NOT on that list — every
     <Space> used as a spacer made inflation throw inside the launcher, so the
     widget NEVER painted (pure white placeholder, regardless of how many
     updates were pushed). Spacers here are now empty TextViews (whitelisted)
     and layout margins. No custom view classes are used. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Brand header -->
    <TextView
        android:id="@+id/widget_brand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="মানিব্যাগ"
        android:textColor="#FF2ED573"
        android:textSize="11sp"
        android:textStyle="bold"
        android:maxLines="1" />

    <!-- flexible spacer (empty TextView — RemoteViews-safe) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text=""
        android:maxLines="1" />

    <!-- Today -->
    <TextView
        android:id="@+id/widget_today_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="আজ"
        android:textColor="#FF8D99B0"
        android:textSize="10sp"
        android:maxLines="1" />

    <TextView
        android:id="@+id/widget_today_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="—"
        android:textColor="#FFF2F5FA"
        android:textSize="17sp"
        android:textStyle="bold"
        android:maxLines="1" />

    <!-- This month (6dp gap now via marginTop) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_month_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="এই মাসে"
            android:textColor="#FF8D99B0"
            android:textSize="10sp"
            android:maxLines="1" />

        <!-- flexible spacer (empty TextView — RemoteViews-safe) -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:text=""
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_month_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#FFF2F5FA"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1" />
    </LinearLayout>

    <!-- v2.2.1: overall budget progress (kept GONE until Dart pushes
         budgetHas=true — [MbWidgetProvider] flips it visible). -->
    <LinearLayout
        android:id="@+id/widget_budget_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_budget_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="বাজেট"
                android:textColor="#FF8D99B0"
                android:textSize="10sp"
                android:maxLines="1" />

            <!-- flexible spacer (empty TextView — RemoteViews-safe) -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:text=""
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_budget_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="#FFF2F5FA"
                android:textSize="10sp"
                android:textStyle="bold"
                android:maxLines="1" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/widget_budget_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="3dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#FF2ED573"
            android:progressBackgroundTint="#26FFFFFF" />
    </LinearLayout>
</LinearLayout>
